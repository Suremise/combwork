{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    // Rules written for the React Compiler, which Combwork doesn't use.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/globals": "off",
    "react/purity": "off",
    "react/memo-dependencies": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/preserve-manual-memoization": "off",
    // Terminal output is matched on control sequences on purpose.
    "no-control-regex": "off",
    // Style preferences, not bugs.
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "no-underscore-dangle": "off",
    // Copies taken before loops that change the collection they walk are on purpose.
    "unicorn/no-useless-spread": "off"
  },
  "overrides": [
    {
      // Electron's fs opens an .asar file as an archive when it is stat-ed or read, and keeps it open until Combwork quits:
      // a project's build output (dist/win-unpacked/resources/app.asar) then can't be deleted or replaced (#246). Main
      // uses original-fs, which treats .asar files as plain files. The scripts that run as plain Node outside the asar
      // (hive-mcp.js, hive-progress.js) use Node's fs.
      "files": ["src/main/**/*.ts", "src/main/**/*.mts"],
      "rules": {
        "no-restricted-imports": ["error", { "paths": [
          { "name": "fs", "message": "Use original-fs in the main process (#246)." },
          { "name": "fs/promises", "message": "Use original-fs/promises in the main process (#246)." },
          { "name": "node:fs", "message": "Use original-fs in the main process (#246)." },
          { "name": "node:fs/promises", "message": "Use original-fs/promises in the main process (#246)." }
        ] }]
      }
    },
    {
      // Node's worker threads (the usage worker, #1106; the repository lock's, HI-1680; the WAL checkpoints', HI-1691; the log's writer, HI-1730; git's, HI-1783; Codex's log's, HI-1972): their postMessage has no target origin (a browser window's has).
      "files": ["src/main/usageWorker.ts", "src/main/usageHistory.ts", "src/main/repoLockWorker.ts", "src/main/repoLock.ts", "tests/repoLockWorker.test.ts", "tests/usageWorker.test.ts", "src/main/walCheckpointWorker.ts", "src/main/walCheckpoint.ts", "src/main/logWriter.ts", "src/main/logger.ts", "src/main/gitWorker.ts", "src/main/git.ts", "tests/gitWorker.test.ts", "src/main/codexLogWorker.ts", "src/main/providers/codex/retryLog.ts"],
      "rules": { "unicorn/require-post-message-target-origin": "off" }
    },
    {
      "files": ["src/main/mcp/cw-mcp.ts", "src/main/progressReporters/cw-progress.ts", "src/main/progressReporters/wrapper.ts", "src/main/progressReporters/report.mts", "src/main/closeCommand/cw-close-runner.ts", "src/main/closeCommand/runner.ts", "src/main/closeCommand/listRunner.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "ignorePatterns": ["out/**", "dist/**", "node_modules/**", "reference/**", "build/**", "resources/**", "tests/fixtures/**"]
}
