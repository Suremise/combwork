{
  "name": "hive",
  "productName": "Hive Desktop",
  "version": "0.9.3",
  "description": "Hive Desktop — a streamlined, agent-first desktop workspace for AI-assisted coding.",
  "main": "./out/main/index.js",
  "author": "Darren Marshall",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Suremise/hive-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suremise/hive-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run lint && npm run licenses && electron-vite build",
    "bundled-history": "node scripts/bundled-history.mjs",
    "console-fixture": "node scripts/consoleFixture.mjs",
    "scenarios": "node tests/scenarios/run.mjs",
    "licenses": "node scripts/licenses.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "release": "node scripts/release.mjs",
    "tested-clis": "node scripts/tested-clis.mjs",
    "lint": "oxlint --deny-warnings src tests scripts",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:concurrency": "node tests/e2e/concurrency.mjs",
    "test:clean": "node tests/e2e/clean.mjs",
    "test:waits": "node scripts/testWaits.mjs",
    "i18n:extract": "node scripts/i18nExtract.mjs",
    "i18n:check": "node scripts/i18nCheck.mjs",
    "i18n:coverage": "node scripts/i18nCoverage.mjs",
    "i18n:guard": "node scripts/i18nGuard.mjs",
    "i18n:numbers": "node scripts/i18nNumbers.mjs"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@formatjs/intl": "6.1.2",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.14",
    "smol-toml": "^1.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.8",
    "@formatjs/cli": "6.16.31",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "//overrides": "#1141: monaco-editor 0.57.0 pins dompurify 3.4.15 (two IN_PLACE advisories). The override fixes npm's copy; the renderer build's hive-monaco-dompurify plugin (electron.vite.config.ts) makes Monaco's own bundled copy Hive's dompurify too. Remove both once Monaco pins 3.4.16 or later: tests/monacoDompurify.test.ts fails then.",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  }
}
